{
  "openapi": "3.0.3",
  "info": {
    "title": "Entity AからTrust Chainを確認する",
    "version": "0.2.0",
    "description": "読者はEntity Aの操作者です。**1 → 2 → 3 → 4**の順で操作してください。各行を開き、**Try it out → Execute**で実行します。まずtarget=B、次にCで2〜4を繰り返します。\n\nBはTrust Anchorに登録済み。Cは自己署名が正しくても未登録です。取得と検証を分け、先にChainの構造を確認します。\n\nここにある `/api` はAを操作する教材用APIです。OpenID Federationの標準endpointではありません。Aが別コンテナのB/C/AnchorへHTTPSでアクセスします。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Entity Aの操作"
    }
  ],
  "paths": {
    "/api/trust": {
      "get": {
        "tags": [
          "Entity Aの操作"
        ],
        "operationId": "showTrust",
        "summary": "1. Aが信頼するAnchorを見る",
        "description": "ネットワークから採用した値ではなく、Aに事前設定されたAnchorのIDと公開鍵thumbprintを表示します。",
        "responses": {
          "200": {
            "description": "Aでの操作結果。stepsを上から読み、表示時はdocumentsのiss/subも比べてください。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "actor": "Entity A",
                  "operation": "trust",
                  "status": "CONFIGURED",
                  "steps": [
                    "実行後のServer responseで、実際の文書・検証結果を確認してください。"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "通信・処理エラー。stepsではなくerror/messageを確認してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/chains/{target}/fetch": {
      "post": {
        "tags": [
          "Entity Aの操作"
        ],
        "operationId": "fetchChain",
        "summary": "2. Chainの文書を取得する（未検証）",
        "description": "Aが対象のEntity Configuration、AnchorのEntity Configuration、対象のSubordinate Statementを取得・保存します。HTTP 200は取得操作の成功です。Cではcomplete=false。まだ信頼の判定はしません。",
        "responses": {
          "200": {
            "description": "Aでの操作結果。stepsを上から読み、表示時はdocumentsのiss/subも比べてください。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "actor": "Entity A",
                  "operation": "fetch",
                  "status": "UNVERIFIED",
                  "steps": [
                    "実行後のServer responseで、実際の文書・検証結果を確認してください。"
                  ],
                  "target": "B",
                  "complete": true
                }
              }
            }
          },
          "502": {
            "description": "通信・処理エラー。stepsではなくerror/messageを確認してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "description": "まずBで成功例を確認し、その後Cで同じ操作を試します。",
            "schema": {
              "type": "string",
              "enum": [
                "B",
                "C"
              ],
              "default": "B"
            }
          }
        ]
      }
    },
    "/api/chains/{target}": {
      "get": {
        "tags": [
          "Entity Aの操作"
        ],
        "operationId": "showChain",
        "summary": "3. Chainの構造と文書を確認する（未検証）",
        "description": "stepsでiss/subを比べてから、documentsのclaimsを読みます。leafとanchorは自己申告、subordinateはAnchorから対象への裏付けです。Cはsubordinateがmissingになります。",
        "responses": {
          "200": {
            "description": "Aでの操作結果。stepsを上から読み、表示時はdocumentsのiss/subも比べてください。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "actor": "Entity A",
                  "operation": "show",
                  "status": "UNVERIFIED",
                  "steps": [
                    "実行後のServer responseで、実際の文書・検証結果を確認してください。"
                  ],
                  "target": "B",
                  "complete": true
                }
              }
            }
          },
          "409": {
            "description": "まだ取得していません。2のfetchを先に実行してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "502": {
            "description": "通信・処理エラー。stepsではなくerror/messageを確認してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "description": "まずBで成功例を確認し、その後Cで同じ操作を試します。",
            "schema": {
              "type": "string",
              "enum": [
                "B",
                "C"
              ],
              "default": "B"
            }
          }
        ]
      }
    },
    "/api/chains/{target}/verify": {
      "post": {
        "tags": [
          "Entity Aの操作"
        ],
        "operationId": "verifyChain",
        "summary": "4. 保存したChainを検証する",
        "description": "同じ保存済み文書を検証し、ネットワークから再取得しません。Bは200/TRUSTED。Cは自己署名のPASS後、422/NOT_TRUSTEDになります。422は期待する負例です。",
        "responses": {
          "200": {
            "description": "Aでの操作結果。stepsを上から読み、表示時はdocumentsのiss/subも比べてください。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "actor": "Entity A",
                  "operation": "verify",
                  "status": "TRUSTED",
                  "steps": [
                    "実行後のServer responseで、実際の文書・検証結果を確認してください。"
                  ],
                  "target": "B",
                  "complete": true
                }
              }
            }
          },
          "409": {
            "description": "まだ取得していません。2のfetchを先に実行してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "422": {
            "description": "チェーン検証で拒否。CではMISSING_SUBORDINATEが期待結果。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "actor": "Entity A",
                  "operation": "verify",
                  "target": "C",
                  "status": "NOT_TRUSTED",
                  "complete": false,
                  "steps": [
                    "PASS: Entity Configurationの自己署名・iss/sub・有効期限（所属の証明ではない）",
                    "PASS: AnchorのEntity ConfigurationをAに事前設定した公開鍵で検証",
                    "NOT_TRUSTED: MISSING_SUBORDINATE: Anchorが対象について発行したStatementがない"
                  ]
                }
              }
            }
          },
          "502": {
            "description": "通信・処理エラー。stepsではなくerror/messageを確認してください。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "target",
            "in": "path",
            "required": true,
            "description": "まずBで成功例を確認し、その後Cで同じ操作を試します。",
            "schema": {
              "type": "string",
              "enum": [
                "B",
                "C"
              ],
              "default": "B"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Result": {
        "type": "object",
        "required": [
          "actor",
          "operation",
          "status",
          "steps"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "example": "Entity A"
          },
          "operation": {
            "type": "string",
            "enum": [
              "trust",
              "fetch",
              "show",
              "verify"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "B",
              "C"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIGURED",
              "UNVERIFIED",
              "TRUSTED",
              "NOT_TRUSTED"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "complete": {
            "type": "boolean",
            "description": "文書が揃ったか。信頼できるかの判定ではありません。"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "leaf",
                    "subordinate",
                    "anchor"
                  ]
                },
                "header": {
                  "type": "object",
                  "additionalProperties": true
                },
                "claims": {
                  "type": "object",
                  "additionalProperties": true
                },
                "compact_jwt": {
                  "type": "string"
                },
                "missing": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
